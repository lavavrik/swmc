{
  "name": "swmc",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-mcp.mjs",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:server": "go test -C server ./...",
    "lint": "eslint .",
    "format": "prettier --write .",
    "extract-font": "tsx scripts/extract-tiny-font.ts",
    "mc": "tsx --tsconfig tsconfig.app.json src/recipe/cli.ts",
    "mcp": "tsx --tsconfig tsconfig.app.json src/mcp/server.ts",
    "build:mcp": "node scripts/build-mcp.mjs",
    "gen:mcp-examples": "tsx scripts/gen-mcp-examples.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "@monaco-editor/react": "^4.7.0",
    "fast-xml-parser": "^5.11.0",
    "monaco-editor": "^0.56.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "wasmoon": "^1.16.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.50.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.2.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.20.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.18",
    "fake-indexeddb": "^6.2.5",
    "globals": "^15.14.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.23.12",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.23.0",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "yaml": "^2.9.0"
  }
}
